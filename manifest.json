{
  "manifest_version": 3,
  "name": "浮签 · 悬浮书签栏",
  "version": "1.1.1",
  "description": "鼠标移到网页顶部展开书签栏，支持文件夹、搜索和自动收起。",
  "minimum_chrome_version": "111",
  "permissions": ["bookmarks", "storage", "favicon"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "浮签 · 设置",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "web_accessible_resources": [{
    "resources": ["_favicon/*"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["shared.js", "bar-styles.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "commands": {
    "toggle-bar": {
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Alt+Shift+B" },
      "description": "展开或收起悬浮书签栏"
    }
  }
}
